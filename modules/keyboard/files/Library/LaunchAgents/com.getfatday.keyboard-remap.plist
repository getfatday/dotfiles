<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.getfatday.keyboard-remap</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<!-- Swap Caps Lock and Control globally, then clear the mapping for HHKB-layout
		     boards that already send Control from the caps-lock position (the global
		     swap would turn it into Caps Lock): PFU HHKB (VendorID 1278) and the QMK
		     tokyo60 (VendorID 0xfeed = 65261). -->
		<string>/usr/bin/hidutil property --set '{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0},{"HIDKeyboardModifierMappingSrc":0x7000000E0,"HIDKeyboardModifierMappingDst":0x700000039},{"HIDKeyboardModifierMappingSrc":0x7000000E4,"HIDKeyboardModifierMappingDst":0x700000039}]}' ; /usr/bin/hidutil property --matching '{"VendorID":1278}' --set '{"UserKeyMapping":[]}' ; /usr/bin/hidutil property --matching '{"VendorID":65261}' --set '{"UserKeyMapping":[]}'</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
