<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.getfatday.keyboard-remap</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<!-- One-directional Caps Lock -> Control remap, applied system-wide.
		     Earlier versions also remapped physical Control keys to send the
		     literal Caps Lock HID usage (0x39), intending a cosmetic swap; that
		     usage is not cosmetic, it drives macOS real persistent caps-lock
		     lock state, so every Control shortcut silently toggled system caps
		     lock, eventually leaving it stuck on with no key able to turn it
		     back off. Dropped that direction entirely. A system-wide (no
		     --matching) mapping of Caps Lock -> Control is safe for every
		     keyboard including HHKB-layout boards (tokyo60, PFU HHKB): they
		     have no physical Caps Lock key, so the rule is a no-op on them and
		     needs no per-device exemption. -->
		<string>/usr/bin/hidutil property --set '{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0}]}'</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
