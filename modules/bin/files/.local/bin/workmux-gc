#!/usr/bin/env bash
# workmux-gc — garbage-collect stale worktrees, branches, and git admin
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null)"
export PATH="$HOME/.local/bin:$PATH"

dry_run=false
notify=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    --notify)  notify=true ;;
  esac
done

# 1. Fetch + prune deleted remote branches
# Promptless: the 1Password SSH agent authorizes per top-level client
# process, so a fresh launchd tick either pops a Touch ID prompt or hangs
# and fails with "agent refused operation". Fetch over HTTPS with the same
# askpass helper dotm uses (reads a token from the gh keyring, silent in
# headless contexts) instead of touching the SSH origin remote. Falls back
# to a fast-failing SSH fetch if the helper isn't installed.
if [[ -x "$HOME/.local/bin/dotm-git-askpass" ]]; then
  GIT_TERMINAL_PROMPT=0 GIT_ASKPASS="$HOME/.local/bin/dotm-git-askpass" \
    git -c credential.helper= fetch --prune --quiet \
    https://github.com/getfatday/dotfiles.git '+refs/heads/*:refs/remotes/origin/*' 2>/dev/null
else
  GIT_SSH_COMMAND='ssh -oBatchMode=yes -oConnectTimeout=10' \
    git fetch --prune --quiet 2>/dev/null
fi

# 2. Remove worktrees whose upstream branch was deleted (PR merged/closed)
if $dry_run; then
  echo "=== Stale worktrees (upstream gone) ==="
  workmux remove --gone --force 2>&1 | head -20
else
  removed=$(workmux remove --gone --force 2>&1)
  echo "$removed"
fi

# 3. Prune orphaned .git/worktrees/ entries
git worktree prune

# 4. Clean orphaned local branches
if $dry_run; then
  echo "=== Orphaned branches ==="
  git unused
else
  git unused -D
fi

# 5. Clean stale Claude session refs
workmux claude prune 2>/dev/null

# 6. Notify on macOS if requested
if $notify && ! $dry_run; then
  stale_count=$(git branch -vv 2>/dev/null | grep 'origin/.*: gone]' | wc -l | tr -d ' ')
  if [[ "$stale_count" -gt 0 ]]; then
    osascript -e "display notification \"$stale_count stale worktree(s) remaining\" with title \"workmux-gc\""
  fi
fi
