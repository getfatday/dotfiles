[user]
  name = Ian Anderson
  email = getfatday@gmail.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHQCDl9wUFLPF1cvH4+PAXir0HcGu/ZtZmIkq9o1zky2

# Expedia identity: any Expedia-owned remote uses the work email (config-work).
# Covers both HTTPS (github.com/org/) and SSH (github.com:org/) URL forms.
# github.com Expedia orgs
[includeIf "hasconfig:remote.*.url:https://github.com/eg-internal/**"]
  path = ~/.config/git/config-work
[includeIf "hasconfig:remote.*.url:git@github.com:eg-internal/**"]
  path = ~/.config/git/config-work
[includeIf "hasconfig:remote.*.url:https://github.com/ianderson_expedia/**"]
  path = ~/.config/git/config-work
[includeIf "hasconfig:remote.*.url:git@github.com:ianderson_expedia/**"]
  path = ~/.config/git/config-work
[includeIf "hasconfig:remote.*.url:https://github.com/ExpediaGroup/**"]
  path = ~/.config/git/config-work
[includeIf "hasconfig:remote.*.url:git@github.com:ExpediaGroup/**"]
  path = ~/.config/git/config-work
# github.expedia.biz: entire internal host, any org
[includeIf "hasconfig:remote.*.url:https://github.expedia.biz/**"]
  path = ~/.config/git/config-work
[includeIf "hasconfig:remote.*.url:git@github.expedia.biz:**"]
  path = ~/.config/git/config-work

[core]
  editor = vi
  excludesfile = ~/.config/git/ignore
  autocrlf = input

[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true

[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto

[init]
  defaultBranch = main

[credential]
  helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[push]
  default = simple

[pull]
  rebase = true

[rebase]
  autosquash = true

[diff]
  tool = Kaleidoscope
[difftool "Kaleidoscope"]
  cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[difftool]
  prompt = false

[merge]
  tool = Kaleidoscope
[mergetool "Kaleidoscope"]
  cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
  trustExitCode = true
[mergetool]
  prompt = false

[alias]
  c = commit
  ca = commit -a
  cm = commit -m
  cam = commit -am
  d = diff
  dc = diff --cached
  l = log --graph --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit
  open = "!~/.local/bin/git-open"
  browse = "!~/.local/bin/git-open"

[web]
  browser = google-chrome
[credential "https://github.expedia.biz"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
