#!/bin/sh
# Fake `op` for the op-agent-sign test suite. Offline: it only reads files named by the harness.
#   FAKE_OP_DIR        scratch dir for call counting / env dump (required)
#   FAKE_OP_MODE       ok | crlf | empty | encrypted | slow | 429 | 401 | wrongkey   (default ok)
#   FAKE_OP_KEY / FAKE_OP_ENC_KEY / FAKE_OP_OTHER_KEY   key files served by ok|crlf / encrypted / wrongkey
#   FAKE_OP_DELAY      seconds to sleep before answering (concurrency tests)
#   FAKE_OP_SLOW_SECS  how long `slow` mode sleeps (default 60)
#   FAKE_OP_TOKEN      value served by `op read -n <ref>` (bootstrap tests)
#   FAKE_OP_PUB / FAKE_OP_PUB_MODE   file served for `op read op://.../public_key` / ok|crlf|multi|bad|rsa|empty
# Verbs: read <ref> | read -n <ref> | --version | whoami | item get <title> ... | service-account ratelimit
: "${FAKE_OP_DIR:?FAKE_OP_DIR not set}"
printf 'call\n' >>"$FAKE_OP_DIR/op.calls"
env | sort >"$FAKE_OP_DIR/op.env"
printf '%s\n' "$1" >>"$FAKE_OP_DIR/op.verbs"
case ${1:-} in
  --version) echo "2.32.1"; exit 0 ;;
  whoami)
    [ "${FAKE_OP_MODE:-ok}" != 401 ] || { echo "[ERROR] (401) Unauthorized: invalid service account token" >&2; exit 1; }
    if [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
      printf 'URL:               https://fakeacct.example.invalid\nIntegration ID:    FAKEINTEGRATION\nUser Type:         SERVICE_ACCOUNT\n'
    else
      printf 'URL:               https://fakeacct.example.invalid\nEmail:             tester@example.invalid\nUser ID:           FAKEUSER\n'
    fi
    exit 0
    ;;
  service-account)
    printf 'TYPE      ACTION    LIMIT    USED    REMAINING    RESET\ntoken     write     100      0       100          never\ntoken     read      1000     1       999          1 hour from now\n'
    exit 0
    ;;
  item)
    [ "${2:-}" = get ] || exit 2
    printf '{\n  "id": "fakeitemid0123456789",\n  "title": "%s",\n  "version": 2,\n  "vault": {\n    "id": "fakevaultid0123456789",\n    "name": "Agent"\n  },\n  "category": "SSH_KEY"\n}\n' "${3:-x}"
    exit 0
    ;;
  read) ;;
  *)
    echo "[ERROR] fake op: unsupported verb" >&2
    exit 2
    ;;
esac
if [ "${2:-}" = -n ]; then
  printf '%s' "${FAKE_OP_TOKEN:?FAKE_OP_TOKEN not set}"
  exit 0
fi
# Desktop-session read of the item's public key: FAKE_OP_PUB_MODE ok | crlf | multi | bad | rsa | empty
case ${2:-} in
  */public_key)
    printf '%s\n' "$2" >>"$FAKE_OP_DIR/op.pubreads"
    case ${FAKE_OP_PUB_MODE:-ok} in
      ok) cat "${FAKE_OP_PUB:?FAKE_OP_PUB not set}" ;;
      crlf) awk '{ printf "%s\r\n", $0 }' "$FAKE_OP_PUB" ;;
      multi) cat "$FAKE_OP_PUB" "$FAKE_OP_PUB" ;;
      bad) echo "ssh-ed25519 AAAAnotakey" ;;
      rsa) echo "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC7" ;;
      empty) exit 0 ;;
    esac
    exit 0
    ;;
esac
[ -z "${FAKE_OP_DELAY:-}" ] || sleep "$FAKE_OP_DELAY"
case ${FAKE_OP_MODE:-ok} in
  ok) cat "$FAKE_OP_KEY" ;;
  crlf) awk '{ printf "%s\r\n", $0 }' "$FAKE_OP_KEY" ;;
  empty) exit 0 ;;
  encrypted) cat "$FAKE_OP_ENC_KEY" ;;
  wrongkey) cat "$FAKE_OP_OTHER_KEY" ;;
  slow) exec sleep "${FAKE_OP_SLOW_SECS:-60}" ;;
  429)
    echo "[ERROR] 2026/01/01 00:00:00 (429) Too Many Requests: rate limit exceeded for this service account" >&2
    exit 1
    ;;
  401)
    echo "[ERROR] 2026/01/01 00:00:00 (401) Unauthorized: invalid service account token (DecodeSACredentials)" >&2
    exit 1
    ;;
  *)
    echo "[ERROR] fake op: unknown FAKE_OP_MODE" >&2
    exit 2
    ;;
esac
