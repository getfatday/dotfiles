#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────────────
# Three Artifactory systems, four consumers
# ─────────────────────────────────────────────────────────
#
#   artylab.expedia.biz          → npm (.npmrc) + Gradle (gradle.properties)
#   artifactory.expedia.biz      → Swift Package Registry (sources scope)
#   artifactory-edge.expedia.biz → Homebrew (HOMEBREW_ARTIFACTORY_API_*)
#
# These are THREE SEPARATE systems with separate identity systems:
# - artylab (legacy self-hosted) accepts username/password directly →
#   derives npm _auth + Gradle props.
# - artifactory.expedia.biz (Swift SPM) requires a UI-generated API key
#   (SSO-backed, separate from artylab).
# - artifactory-edge.expedia.biz is Artifactory Cloud (JFrog-hosted, the
#   artylab replacement) — auth is Okta/SAML SSO only, so a plain artylab
#   username/password does NOT work here. It needs a username + Artifactory
#   Cloud identity token generated from your Cloud profile.
# Both non-artylab tokens are cached in macOS keychain so you only enter
# them once.
#
# Usage:
#   rotate-artifactory-credentials [--op-item <1Password item>] [--non-interactive]
#
#   --op-item <item>   Pull the artylab username/password from 1Password
#                      (fields: username, password) via `op`. Also honors
#                      the OP_ARTYLAB_ITEM env var.
#   --non-interactive  Never prompt; sections without credentials are
#                      skipped and reported. Exit 1 if any section failed.
#
# A section that fails no longer aborts the script — every section runs,
# and the summary reports real per-section status.

ARTYLAB="https://artylab.expedia.biz"
# public-npm-virtual aggregates internal + public feeds. eg-npm-internal-local
# had a broken catalog for @egds packages (only 1 stale version), causing
# pnpm install failures on @egds scope resolution. Use the virtual repo.
ARTYLAB_NPM_HOST="//artylab.expedia.biz/api/npm/public-npm-virtual/"
EGDS_NPM_REGISTRY="${ARTYLAB}/api/npm/public-npm-virtual/"
NPMRC="$HOME/.npmrc"
GRADLE_PROPS="$HOME/.gradle/gradle.properties"

ARTIFACTORY="https://artifactory.expedia.biz"
SPM_REGISTRY="${ARTIFACTORY}/artifactory/api/swift/eg-internal-swift"
KEYCHAIN_SERVICE="rotate-artifactory-credentials"
KEYCHAIN_SPM_ACCOUNT="spm-token"

ARTIFACTORY_CLOUD="https://artifactory-edge.expedia.biz"
KEYCHAIN_HOMEBREW_ACCOUNT="homebrew-artifactory-cloud-token"
HOMEBREW_ARTIFACTORY_ENV="$HOME/.config/artifactory-env.sh"

OP_ITEM="${OP_ARTYLAB_ITEM:-t5q6afn7i4bwcy5u2a4cidhx4y}"
NON_INTERACTIVE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --op-item) OP_ITEM="$2"; shift 2 ;;
    --non-interactive) NON_INTERACTIVE=1; shift ;;
    *) echo "Unknown flag: $1" >&2; exit 2 ;;
  esac
done

STATUS_NPM="SKIPPED"
STATUS_GRADLE="SKIPPED"
STATUS_HOMEBREW="SKIPPED"
STATUS_SWIFT="SKIPPED"

# ─────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────
clean_leading_blanks() {
  python3 -c "
import sys
lines = open(sys.argv[1]).readlines()
start = next((i for i,l in enumerate(lines) if l.strip()), 0)
open(sys.argv[1], 'w').writelines(lines[start:])
" "$1"
}

update_file() {
  # Usage: update_file <file> <exclude_pattern> <content>
  local file="$1" pattern="$2" content="$3"
  python3 -c "
import re, os, sys
path = sys.argv[1]
pattern = sys.argv[2]
content = sys.argv[3]
try:
    with open(path, 'r') as f:
        lines = [l for l in f.readlines() if not re.search(pattern, l)]
except FileNotFoundError:
    lines = []
text = ''.join(lines).rstrip('\n') + '\n' + content + '\n'
os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
with open(path, 'w') as f:
    f.write(text.lstrip('\n'))
" "$file" "$pattern" "$content"
}

keychain_get() {
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" -w 2>/dev/null || true
}

keychain_set() {
  security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" >/dev/null 2>&1 || true
  security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" -w "$2"
}

echo "=== Artifactory credential setup ==="
echo ""
echo "Three systems:"
echo "  1. artylab.expedia.biz        → npm + Gradle (Android)"
echo "  2. artifactory-edge.expedia.biz → Homebrew (Artifactory Cloud)"
echo "  3. artifactory.expedia.biz    → Swift SPM (iOS)"
echo ""

# ─────────────────────────────────────────────────────────
# 1. artylab.expedia.biz (npm + Gradle)
# ─────────────────────────────────────────────────────────
echo "--- artylab.expedia.biz ---"

ARTYLAB_USER=""
ARTYLAB_PASS=""

# Credentials from 1Password when requested (non-interactive capable).
if [[ -n "$OP_ITEM" ]]; then
  if command -v op >/dev/null 2>&1; then
    echo "  Pulling credentials from 1Password item: ${OP_ITEM}"
    ARTYLAB_USER="$(op item get "$OP_ITEM" --fields label=username --reveal 2>/dev/null || true)"
    ARTYLAB_PASS="$(op item get "$OP_ITEM" --fields label=password --reveal 2>/dev/null || true)"
    if [[ -z "$ARTYLAB_USER" || -z "$ARTYLAB_PASS" ]]; then
      echo "  Could not read username/password from op item '${OP_ITEM}' (not signed in, or fields missing)."
      ARTYLAB_USER=""; ARTYLAB_PASS=""
    fi
  else
    echo "  --op-item given but 'op' CLI not found."
  fi
fi

if [[ -z "$ARTYLAB_USER" && "$NON_INTERACTIVE" == "0" ]]; then
  DEFAULT_USER="$(whoami)"
  read -rp "EG username [${DEFAULT_USER}]: " ARTYLAB_USER
  ARTYLAB_USER="${ARTYLAB_USER:-$DEFAULT_USER}"
  read -rsp "artylab password: " ARTYLAB_PASS
  echo ""
fi

ARTYLAB_OK=0
NPMRC_AUTH_BODY=""
if [[ -n "$ARTYLAB_USER" && -n "$ARTYLAB_PASS" ]]; then
  # Validate against /api/npm/auth — the endpoint we actually need. NOTE:
  # /api/system/ping answers 200 WITHOUT auth, so it validates nothing
  # (this masked real auth failures in earlier versions of this script).
  ATTEMPTS=0
  while :; do
    ATTEMPTS=$((ATTEMPTS + 1))
    echo "Validating (via /api/npm/auth)..."
    NPMRC_AUTH_BODY="$(mktemp)"
    HTTP_CODE=$(curl -s -o "$NPMRC_AUTH_BODY" -w "%{http_code}" -u "${ARTYLAB_USER}:${ARTYLAB_PASS}" "${ARTYLAB}/api/npm/auth")
    if [[ "$HTTP_CODE" == "200" ]]; then
      echo "Valid."
      ARTYLAB_OK=1
      break
    fi
    echo "artylab rejected the credentials (HTTP ${HTTP_CODE} from /api/npm/auth)."
    if [[ "$HTTP_CODE" == "401" || "$HTTP_CODE" == "403" ]]; then
      echo "  → wrong password, expired/locked account, or artylab password auth disabled (Cloud migration)."
    fi
    rm -f "$NPMRC_AUTH_BODY"; NPMRC_AUTH_BODY=""
    if [[ "$NON_INTERACTIVE" == "1" || -n "$OP_ITEM" || "$ATTEMPTS" -ge 3 ]]; then
      break
    fi
    read -rsp "Retry artylab password for ${ARTYLAB_USER} (attempt $((ATTEMPTS + 1))/3): " ARTYLAB_PASS
    echo ""
  done
else
  echo "  No artylab credentials available. Skipping npm + Gradle."
fi

if [[ "$ARTYLAB_OK" == "1" ]]; then
  # npm — reuse the validated /api/npm/auth response
  echo "  npm → ~/.npmrc"
  # Anchored parse: the _auth value is base64 and may END with '=' padding,
  # so a greedy 's/.*= *//' eats the whole token. Strip the key prefix instead.
  NPM_AUTH_TOKEN=$(grep '^_auth' "$NPMRC_AUTH_BODY" | head -1 | sed 's/^_auth[[:space:]]*=[[:space:]]*//' | tr -d '"' | tr -d '[:space:]')
  rm -f "$NPMRC_AUTH_BODY"; NPMRC_AUTH_BODY=""

  if [[ -n "$NPM_AUTH_TOKEN" ]]; then
    update_file "$NPMRC" "^@egds:registry=|artylab\\.expedia\\.biz" "
# @egds Artifactory registry (managed by rotate-artifactory-credentials)
@egds:registry=${EGDS_NPM_REGISTRY}
${ARTYLAB_NPM_HOST}:_auth=${NPM_AUTH_TOKEN}"
    STATUS_NPM="OK"
    echo "    done."
  else
    STATUS_NPM="FAILED (200 but no _auth in response — format changed?)"
    echo "    /api/npm/auth returned 200 but no _auth line found — response format changed?"
  fi

  # Gradle
  echo "  Gradle → ~/.gradle/gradle.properties"
  update_file "$GRADLE_PROPS" "^ARTIFACTORY_|^# Artifactory credentials" "
# Artifactory credentials (managed by rotate-artifactory-credentials)
ARTIFACTORY_USER=${ARTYLAB_USER}
ARTIFACTORY_PASS=${ARTYLAB_PASS}
ARTIFACTORY_USERNAME=${ARTYLAB_USER}
ARTIFACTORY_PASSWORD=${ARTYLAB_PASS}"
  STATUS_GRADLE="OK"
  echo "    done."
elif [[ -n "$ARTYLAB_USER" ]]; then
  echo "  artylab auth FAILED — npm + Gradle not updated. Continuing with other systems."
  STATUS_NPM="FAILED (auth)"
  STATUS_GRADLE="FAILED (auth)"
fi

# ─────────────────────────────────────────────────────────
# 2. Homebrew (artifactory-edge.expedia.biz / Artifactory Cloud)
# ─────────────────────────────────────────────────────────
# NOTE: this is Okta/SAML-SSO-backed Artifactory Cloud, NOT artylab.
# artylab username/password will not authenticate here — this needs a
# personal Artifactory Cloud identity token.
echo ""
echo "--- Homebrew (artifactory-edge.expedia.biz / Artifactory Cloud) ---"

HOMEBREW_TOKEN=""
HOMEBREW_USER="${ARTYLAB_USER:-$(whoami)}"

# Try keychain first
CACHED=$(keychain_get "$KEYCHAIN_HOMEBREW_ACCOUNT")
if [[ -n "$CACHED" ]]; then
  echo "  Found cached identity token in keychain."
  HOMEBREW_TOKEN="$CACHED"
fi

# If no cached token, prompt once (unless non-interactive)
if [[ -z "$HOMEBREW_TOKEN" && "$NON_INTERACTIVE" == "0" ]]; then
  echo ""
  echo "  No cached token found. A one-time setup is needed."
  echo ""
  echo "  Generate an identity token from:"
  echo "    ${ARTIFACTORY_CLOUD}/ui/admin/artifactory/user_profile"
  echo "    → Log in via Okta SSO → Generate Identity Token"
  echo ""
  echo "  (This token will be cached in your macOS keychain."
  echo "   Future runs will use it automatically.)"
  echo ""
  read -rsp "  Paste your artifactory-edge.expedia.biz identity token: " HOMEBREW_TOKEN
  echo ""

  if [[ -z "$HOMEBREW_TOKEN" ]]; then
    echo "  No token provided. Skipped."
  fi
fi

if [[ -n "$HOMEBREW_TOKEN" ]]; then
  echo "  Validating..."
  HB_CODE=$(curl -s -o /dev/null -w "%{http_code}" -u "${HOMEBREW_USER}:${HOMEBREW_TOKEN}" "${ARTIFACTORY_CLOUD}/api/system/ping")
  if [[ "$HB_CODE" != "200" ]]; then
    echo "  Validation failed (HTTP ${HB_CODE}). Not caching or writing — check the token and re-run."
    STATUS_HOMEBREW="FAILED (HTTP ${HB_CODE})"
  else
    echo "  Valid."
    update_file "$HOMEBREW_ARTIFACTORY_ENV" "^export HOMEBREW_ARTIFACTORY_API_|^# Homebrew Artifactory Cloud credentials" "
# Homebrew Artifactory Cloud credentials (managed by rotate-artifactory-credentials)
export HOMEBREW_ARTIFACTORY_API_USER=${HOMEBREW_USER}
export HOMEBREW_ARTIFACTORY_API_TOKEN=${HOMEBREW_TOKEN}"
    chmod 600 "$HOMEBREW_ARTIFACTORY_ENV"
    keychain_set "$KEYCHAIN_HOMEBREW_ACCOUNT" "$HOMEBREW_TOKEN"
    STATUS_HOMEBREW="OK"
    echo "  ${HOMEBREW_ARTIFACTORY_ENV} written."
    echo "  Token cached in keychain (future runs skip this prompt)."
  fi
fi

# ─────────────────────────────────────────────────────────
# 3. artifactory.expedia.biz (Swift SPM)
# ─────────────────────────────────────────────────────────
echo ""
echo "--- artifactory.expedia.biz (Swift SPM) ---"

if ! command -v swift >/dev/null 2>&1; then
  echo "  swift not found. Skipped."
else
  SPM_TOKEN=""

  # Try keychain first
  CACHED=$(keychain_get "$KEYCHAIN_SPM_ACCOUNT")
  if [[ -n "$CACHED" ]]; then
    echo "  Found cached token in keychain."
    SPM_TOKEN="$CACHED"
  fi

  # If no cached token, prompt once (unless non-interactive)
  if [[ -z "$SPM_TOKEN" && "$NON_INTERACTIVE" == "0" ]]; then
    echo ""
    echo "  No cached token found. A one-time setup is needed."
    echo ""
    echo "  Get your token from: https://artifactory.expedia.biz/"
    echo "    → Log in → Profile → Edit Profile → Generate API Key"
    echo ""
    echo "  (This token will be cached in your macOS keychain."
    echo "   Future runs will use it automatically.)"
    echo ""
    read -rsp "  Paste your artifactory.expedia.biz API token: " SPM_TOKEN
    echo ""

    if [[ -z "$SPM_TOKEN" ]]; then
      echo "  No token provided. Skipped."
    fi
  fi

  if [[ -n "$SPM_TOKEN" ]]; then
    # Write .netrc directly (swift package-registry login validates against
    # the server which may reject tokens that actually work for package resolution)
    export _NETRC_USER="${ARTYLAB_USER:-$(whoami)}"
    export _NETRC_PASS="$SPM_TOKEN"
    python3 -c '
import re, os

user = os.environ["_NETRC_USER"]
token = os.environ["_NETRC_PASS"]
path = os.path.expanduser("~/.netrc")

try:
    content = open(path).read()
except FileNotFoundError:
    content = ""

# Remove existing artifactory block
content = re.sub(
    r"machine artifactory\.expedia\.biz\nlogin [^\n]*\npassword[^\n]*\n?",
    "", content
)
content = content.rstrip("\n") + (
    f"\n\nmachine artifactory.expedia.biz\n"
    f"login {user}\n"
    f"password {token}\n"
)
with open(path, "w") as f:
    f.write(content.lstrip("\n"))
os.chmod(path, 0o600)
'
    unset _NETRC_USER _NETRC_PASS

    # Configure registry URLs
    swift package-registry set --global "${SPM_REGISTRY}" 2>/dev/null || true
    swift package-registry set --global --scope sources "${SPM_REGISTRY}" 2>/dev/null || true

    # Cache in keychain
    keychain_set "$KEYCHAIN_SPM_ACCOUNT" "$SPM_TOKEN"

    STATUS_SWIFT="OK"
    echo "  Swift package registry configured."
    echo "  Token cached in keychain (future runs skip this prompt)."
  fi
fi

# ─────────────────────────────────────────────────────────
# Summary — reports what actually happened, per section
# ─────────────────────────────────────────────────────────
echo ""
echo "=== Done ==="
echo ""
echo "  npm      (~/.npmrc → artylab):           ${STATUS_NPM}"
echo "  Gradle   (~/.gradle/gradle.properties):  ${STATUS_GRADLE}"
echo "  Homebrew (~/.config/artifactory-env.sh): ${STATUS_HOMEBREW}"
echo "  Swift    (~/.netrc + registries.json):   ${STATUS_SWIFT}"
echo ""
echo "Test:"
echo "  npm:     pnpm install (in @egds project)"
echo "  Android: ./gradlew :components:core:assembleDebug"
echo "  iOS:     swift package resolve"

if [[ "$STATUS_NPM" == FAILED* || "$STATUS_HOMEBREW" == FAILED* ]]; then
  exit 1
fi
