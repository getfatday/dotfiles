#!/usr/bin/env bash
# hermes-timesheets-bootstrap: idempotently (re)builds the Hermes `timesheets` agent from the
# files this dotfiles module stows under ~/.local/share/hermes-bridge/timesheets.
#   profile `timesheets` (no alias, no bundled skills), terminal.timeout raised for bridge calls
#   scripts/create-week-card.sh + scripts/receipt-contract.md (copies; Hermes rejects links out)
#   skills/timesheet-runner -> symlink into the stowed skill
#   timesheets.env sidecar: TIMESHEETS_MODE (canary unless already set; never downgraded here)
#   kanban board `timesheets`
#   cron job `timesheet-weekly` '0 9 * * 1', created PAUSED; resume it yourself
# It never installs a gateway, never resumes a job and makes no model calls.
# Usage: hermes-timesheets-bootstrap [--check]
set -euo pipefail
HERMES="${HERMES_BIN:-$HOME/.local/bin/hermes}"
SRC="$(cd "$(dirname "$0")/../share/hermes-bridge/timesheets" && pwd)"
P="$HOME/.hermes/profiles/timesheets"
check=0; [ "${1:-}" = "--check" ] && check=1
say() { printf '%-10s %s\n' "$1" "$2"; }
h() { NO_COLOR=1 "$HERMES" "$@"; }

if [ -d "$P" ]; then say ok "profile timesheets exists"
elif [ $check = 1 ]; then say missing "profile timesheets"
else h profile create timesheets --no-alias --no-skills \
  --description "Runs the weekly timesheet card: drives the vault /timesheet and /vendor-timesheets skills through claude-bridge and keeps the card as the receipt." >/dev/null
  say created "profile timesheets"; fi
[ $check = 1 ] && [ ! -d "$P" ] && exit 1

if [ $check = 0 ]; then
  mkdir -p "$P/scripts" "$P/skills"
  install -m 0755 "$SRC/create-week-card.sh" "$P/scripts/create-week-card.sh"
  install -m 0644 "$SRC/receipt-contract.md" "$P/scripts/receipt-contract.md"
  ln -sfn "$SRC/skills/timesheet-runner" "$P/skills/timesheet-runner"
  [ -f "$P/timesheets.env" ] || printf 'TIMESHEETS_MODE=canary\n' > "$P/timesheets.env"
  h -p timesheets config set terminal.timeout 1800 >/dev/null
  say synced "scripts, skill link, sidecar ($(cat "$P/timesheets.env")), terminal.timeout=1800"
fi

if h kanban boards list | grep -qE '(^|[[:space:]])timesheets([[:space:]]|$)'; then say ok "board timesheets exists"
elif [ $check = 1 ]; then say missing "board timesheets"
else h kanban boards create timesheets >/dev/null; say created "board timesheets"; fi

if [ -d "$P" ] && h -p timesheets cron list --all 2>/dev/null | grep -q 'timesheet-weekly'; then
  say ok "cron job timesheet-weekly exists (state unchanged)"
elif [ $check = 1 ]; then say missing "cron job timesheet-weekly"
else h -p timesheets cron create '0 9 * * 1' --name timesheet-weekly --no-agent \
    --script create-week-card.sh --deliver local --paused \
    --paused-reason "Created by hermes-timesheets-bootstrap; resume after the canary passes" >/dev/null
  say created "cron job timesheet-weekly (paused)"; fi
