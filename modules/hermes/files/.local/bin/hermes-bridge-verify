#!/usr/bin/env bash
# hermes-bridge-verify: binary assertions for the Hermes <-> Claude Code bridge. Exit 0 = all pass.
# Default is free (no model calls). --live adds two cheap round trips (about $0.01 total).
set -uo pipefail; live=0; [ "${1:-}" = "--live" ] && live=1
pass=0; fail=0; t() { if eval "$2" >/dev/null 2>&1; then echo "PASS $1"; pass=$((pass+1)); else echo "FAIL $1"; fail=$((fail+1)); fi; }
H=$HOME/.local/bin
# Optional machine-local settings (not in git), e.g. on a machine whose Hermes lives elsewhere:
#   HERMES_BIN=/path/to/hermes  HERMES_HOME=/path/to/hermes-home  HERMES_BRIDGE_MODEL=""  HERMES_BRIDGE_PROVIDER=""
CFG="${HERMES_BRIDGE_ENV:-$HOME/.config/hermes-bridge/env}"
# shellcheck disable=SC1090
[ -r "$CFG" ] && . "$CFG"
HERMES="${HERMES_BIN:-hermes}"
[ -n "${HERMES_HOME:-}" ] && export HERMES_HOME
t "A1 hermes-bridge on PATH and executable"     "[ -x $H/hermes-bridge ] || command -v hermes-bridge"
t "A2 claude-bridge on PATH and executable"     "[ -x $H/claude-bridge ] || command -v claude-bridge"
t "A3 hermes-bridge status returns ok JSON"     "hermes-bridge status | jq -e .ok"
t "A4 headless Claude can authenticate (token file or normal login)" "claude-bridge doctor | jq -e '.token_env_readable==true' || claude auth status --json 2>/dev/null | jq -e '.loggedIn==true'"
t "A9 both wrappers are pass-through (no policy)" "claude-bridge doctor | jq -e '.policy==\"pass-through\"' && hermes-bridge doctor | jq -e '.policy==\"pass-through\"'"
t "A5 claude-bridge list returns a JSON array"  "claude-bridge list | jq -e 'type==\"array\"'"
t "A6 Claude skill 'hermes' is installed"       "grep -q '^name: hermes' $HOME/.claude/skills/hermes/SKILL.md"
t "A7 Hermes sees claude-code-bridge skill"     "[ -n \"\$(\"\$HERMES\" skills list 2>&1 | grep claude-code-bridge)\" ]"
# A8 follows symlinks (find -L): after dotm apply every file here is a link into ~/.dotmodules.
t "A8 no secret values in module files"         "! find -L $HOME/.claude/skills/hermes $HOME/.local/share/hermes-bridge/hermes-skills $H/hermes-bridge $H/claude-bridge $H/hermes-bridge-setup -type f -exec grep -EIl 'sk-ant-|oat01|ANTHROPIC_API_KEY=.' {} + | grep -q ."
if [ $live -eq 1 ]; then
  s=$(hermes-bridge ask -- 'Remember this word: ALPHA-1. Reply with exactly: STORED' | jq -r .session_id)
  t "L1 Claude->Hermes ask then resume recalls context" "hermes-bridge ask --resume $s -- 'What was the word I gave you in my first message? Reply with only that word.' | jq -e '.result|test(\"ALPHA-1\")'"
  c=$(claude-bridge ask --model claude-haiku-5-5 -- 'Remember this word: BETA-2. Reply with exactly: STORED' | jq -r .session_id)
  t "L2 Hermes->Claude ask then resume recalls context" "claude-bridge ask --model claude-haiku-5-5 --resume $c -- 'What was the word I gave you in my first message? Reply with only that word.' | jq -e '.result|test(\"BETA-2\")'"
fi
echo "RESULT pass=$pass fail=$fail"; [ $fail -eq 0 ]
